     @RequiresApi(Build.VERSION_CODES.N)
+    private void collectClockPlaceholders(View view, List<android.widget.TextView> into) {
+        if (view instanceof android.widget.TextView
+            && view.getTag() instanceof com.reactnativeandroidwidget.builder.widget.TextWidget.ClockTag) {
+            into.add((android.widget.TextView) view);
+        }
+        if (view instanceof ViewGroup) {
+            ViewGroup group = (ViewGroup) view;
+            for (int i = 0; i < group.getChildCount(); i++) {
+                collectClockPlaceholders(group.getChildAt(i), into);
+            }
+        }
+    }
+
+    /** A live clock cannot be part of the bitmap, so it is a real TextClock laid over its placeholder. */
+    private void addClockViews(int widgetId, RemoteViews remoteWidgetView, WidgetWithViews widgetWithViews) {
+        remoteWidgetView.removeAllViews(R.id.rn_widget_clock_container);
+        ViewGroup rootView = (ViewGroup) widgetWithViews.getRootView();
+        List<android.widget.TextView> placeholders = new java.util.ArrayList<>();
+        collectClockPlaceholders(rootView, placeholders);
+        for (android.widget.TextView placeholder : placeholders) {
+            Rect bounds = new Rect();
+            placeholder.getDrawingRect(bounds);
+            rootView.offsetDescendantRectToMyCoords(placeholder, bounds);
+            RemoteViews clock = new RemoteViews(appContext.getPackageName(), R.layout.rn_widget_clock);
+            clock.setViewPadding(
+                R.id.rn_widget_clock_positioner,
+                bounds.left,
+                bounds.top,
+                RNWidgetUtil.dpToPx(appContext, RNWidgetUtil.getWidgetWidth(appContext, widgetId)) - bounds.right,
+                0
+            );
+            clock.setTextViewTextSize(R.id.rn_widget_clock_text, TypedValue.COMPLEX_UNIT_PX, placeholder.getTextSize());
+            clock.setTextColor(
+                R.id.rn_widget_clock_text,
+                ((com.reactnativeandroidwidget.builder.widget.TextWidget.ClockTag) placeholder.getTag()).color
+            );
+            clock.setInt(R.id.rn_widget_clock_text, "setGravity", placeholder.getGravity());
+            remoteWidgetView.addView(R.id.rn_widget_clock_container, clock);
+        }
+    }
